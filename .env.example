BOTICAYA_DB_HOST=localhost
BOTICAYA_DB_PORT=5432
BOTICAYA_DB_NAME=boticaya_dev
BOTICAYA_DB_USER=
BOTICAYA_DB_PASSWORD=
BOTICAYA_DB_SSL=false
