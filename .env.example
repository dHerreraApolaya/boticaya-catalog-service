# BOTICAYA_DB_CA_FILE=/absolute/path/to/database-ca.crt
BOTICAYA_HOST=127.0.0.1
PORT=8081
BOTICAYA_ORDERS_ENABLED=false

# Vercel only: public trusted CA PEM with real newlines (omit CA_FILE).
# BOTICAYA_DB_CA_PEM=
# BOTICAYA_WEB_ORIGIN=https://your-approved-frontend.example
